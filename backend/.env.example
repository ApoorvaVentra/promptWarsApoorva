# Gemini — loaded from Secret Manager first, falls back to this env var
# To store in Secret Manager:
#   echo -n "YOUR_KEY" | gcloud secrets create GEMINI_API_KEY --data-file=- --project=promptwarsapoorva
#   gcloud secrets add-iam-policy-binding GEMINI_API_KEY \
#     --member="serviceAccount:759244730253-compute@developer.gserviceaccount.com" \
#     --role="roles/secretmanager.secretAccessor" --project=promptwarsapoorva
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps JavaScript API (required for map panel)
GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# Google Places API (New) — same key works if Places API is enabled
GOOGLE_PLACES_API_KEY=your_places_api_key_here

# Optional: protect all API endpoints with a shared secret
# Frontend fetches this from /config and includes it as X-API-Key header
# Leave unset to disable auth (open access)
# VOYAGER_API_KEY=generate-a-random-string-here

# GCP project for Secret Manager (defaults to promptwarsapoorva)
# GCP_PROJECT=promptwarsapoorva

# Firebase / Firestore service account JSON path (optional; uses ADC on Cloud Run)
# FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccount.json

# Google Cloud Logging uses Application Default Credentials automatically on Cloud Run.
# For local dev: run `gcloud auth application-default login`
