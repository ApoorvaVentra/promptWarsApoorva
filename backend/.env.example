# Gemini (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps JavaScript API (required for map panel)
GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# Google Places API (New) — same key works if Places API is enabled
GOOGLE_PLACES_API_KEY=your_places_api_key_here

# Firebase / Firestore service account JSON path (optional; uses ADC on Cloud Run)
# FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccount.json

# Google Cloud Logging uses Application Default Credentials automatically on Cloud Run.
# For local dev: run `gcloud auth application-default login`
